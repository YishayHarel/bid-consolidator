{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "backend",
      "port": 4000
    },
    {
      "name": "backend-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/server.ts"
      ],
      "cwd": "backend",
      "port": 4000,
      "env": {
        "DATABASE_URL": "",
        "SUPABASE_URL": "",
        "SUPABASE_SERVICE_KEY": "",
        "GEMINI_API_KEY": "",
        "SMTP_HOST": "",
        "DB_HOST": "/tmp",
        "DB_NAME": "bc_browser",
        "FRONTEND_URL": "http://localhost:5173",
        "NODE_ENV": "development",
        "PORT": "4000"
      }
    },
    {
      "name": "backend-outlook-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "src/server.ts"
      ],
      "cwd": "backend",
      "port": 4000,
      "env": {
        "DATABASE_URL": "",
        "SUPABASE_URL": "",
        "SUPABASE_SERVICE_KEY": "",
        "GEMINI_API_KEY": "",
        "SMTP_HOST": "",
        "DB_HOST": "/tmp",
        "DB_NAME": "bc_browser",
        "FRONTEND_URL": "http://localhost:5173",
        "NODE_ENV": "development",
        "PORT": "4000",
        "MS_TENANT_ID": "test-tenant",
        "MS_CLIENT_ID": "test-client",
        "MS_CLIENT_SECRET": "test-secret",
        "MS_LOGIN_URL": "http://127.0.0.1:47811/login",
        "MS_GRAPH_URL": "http://127.0.0.1:47811/graph",
        "PUBLIC_API_URL": "http://localhost:4000",
        "MAIL_SEND_INTERVAL_MS": "400"
      }
    },
    {
      "name": "fake-microsoft",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/fake-microsoft.ts"
      ],
      "cwd": "backend",
      "port": 47811,
      "env": {
        "JWT_SECRET": "local-dev-only-local-dev-only-0123456789",
        "LOG_LEVEL": "info"
      }
    }
  ]
}
