# Copy to .env for local development. On Render, set these in the dashboard
# (Environment tab). Every variable is validated at startup (src/config.ts):
# a missing required value stops the server with a clear message.

# ---- Required ------------------------------------------------------------------
# 32+ random characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---- Database --------------------------------------------------------------------
# Production (Supabase): use the SESSION pooler URI (port 5432) — the job queue
# and migration lock need a session, not the transaction pooler (port 6543).
DATABASE_URL=
# Optional: Supabase's CA certificate (PEM, newlines as \n) to fully verify TLS.
DB_CA_CERT=
# Local development: leave DATABASE_URL empty and use these.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bid_consolidator
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=10

# ---- File storage (REQUIRED in production) -----------------------------------------
# Without these, uploads go to local disk — fine for dev, lost on every Render deploy.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# ---- Web ---------------------------------------------------------------------------
# Allowed browser origins (comma-separated), e.g. https://bid-consolidator.vercel.app
FRONTEND_URL=http://localhost:5173
# Base URL for links inside emails (factory portal links). Defaults to the first FRONTEND_URL.
PUBLIC_APP_URL=

# ---- Email: send from each buyer's own Outlook (Microsoft 365) -------------------------
# Set all three to turn on "Connect Outlook" (see DEPLOY.md → Outlook sending).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Encrypts stored Outlook tokens. Optional (derived from JWT_SECRET when unset), but
# setting it lets you rotate JWT_SECRET without everyone reconnecting Outlook.
MAIL_TOKEN_KEY=
# Public URL of THIS API, used for Microsoft's redirect. Render sets RENDER_EXTERNAL_URL,
# so leave blank there; locally it defaults to http://localhost:4000.
PUBLIC_API_URL=

# ---- Email fallback (optional) — company SMTP, used only for buyers without Outlook --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=

# ---- AI CAD reading (optional) — without it, each uploaded CAD becomes one item -----
# Use a PAID Gemini key for customer artwork (free-tier data may be used for training).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Operations ------------------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
MIGRATE_ON_START=true     # apply pending migrations on boot (lock-protected)
RUN_JOBS=true             # run background workers in this process
JOB_CONCURRENCY=2
